# Copie para .env (o backend e os scripts database/scripts/*.py leem este arquivo)
PERSISTENCE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=RH_Jornada
POSTGRES_USER=rh_admin
POSTGRES_PASSWORD=troque-esta-senha
# Relay da outbox -> RabbitMQ (deixe memory:// para não publicar)
RABBITMQ_URL=memory://
OUTBOX_INTERVALO_SEGUNDOS=2
OUTBOX_MAX_TENTATIVAS=5
